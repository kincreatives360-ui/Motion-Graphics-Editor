{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/motion-graphics-editor",
    "build": "npm run build --workspace=@workspace/motion-graphics-editor && node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive: true, force: true}); fs.cpSync('artifacts/motion-graphics-editor/dist', 'dist', {recursive: true});\"",
    "lint": "tsc --build --noEmit",
    "typecheck": "tsc --build && npm run typecheck --workspace=@workspace/motion-graphics-editor",
    "test": "npm run test --workspace=@workspace/motion-graphics-editor"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@types/gif.js": "^0.2.5",
    "gif.js": "^0.2.0",
    "idb": "^8.0.3",
    "mp4-muxer": "^5.2.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
